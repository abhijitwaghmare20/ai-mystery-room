{
  "name": "ai-mystery-room",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "build": "npm --workspace client run build",
    "start": "npm --workspace server start",
    "lint": "npm --workspace client run lint"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
